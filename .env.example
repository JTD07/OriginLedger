# Application — required
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — public (safe for the browser)
# For local development, copy the API URL and anon key printed by `pnpm supabase:start`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — server only (never expose to the client, never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — public
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe — server only
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend — server only
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Sentry — public DSN is safe for the browser; the auth token is server only
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
