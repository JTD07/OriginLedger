# Application — required
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — public (safe for the browser). Required for authentication.
# For local development, copy the API URL and publishable (or legacy anon) key
# printed by `pnpm supabase:start`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — server only (never expose to the client, never prefix with NEXT_PUBLIC_)
# Required for signed upload/preview URLs and trusted asset processing.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — public (publishable key only)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe — server only (never prefix with NEXT_PUBLIC_)
# Use test-mode values. See docs/STRIPE_TEST_MODE.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_AGENCY=
STRIPE_PRICE_AGENCY_PLUS=

# Resend — server only
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Sentry — public DSN is safe for the browser; the auth token is server/CI only.
# Never prefix SENTRY_AUTH_TOKEN with NEXT_PUBLIC_. Leave these empty for local
# work unless you are deliberately sending events to a Sentry project.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_VERSION=0.1.0
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
# Set to true only in CI or a production build that should upload source maps.
SENTRY_UPLOAD_SOURCEMAPS=

# Organization export/deletion product settings (not legal requirements)
ORGANIZATION_EXPORT_EXPIRES_HOURS=168
ORGANIZATION_DELETION_RETENTION_DAYS=
