# Application — required
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — public (safe for the browser). Required for authentication.
# For local development, copy the API URL and publishable (or legacy anon) key
# printed by `pnpm supabase:start`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — server only (never expose to the client, never prefix with NEXT_PUBLIC_)
# Required for signed upload/preview URLs and trusted asset processing.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — public (publishable key only)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe — server only (never prefix with NEXT_PUBLIC_)
# Use test-mode values. See docs/STRIPE_TEST_MODE.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_AGENCY=
STRIPE_PRICE_AGENCY_PLUS=

# Resend — server only
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Sentry — public DSN is safe for the browser; the auth token is server only
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
